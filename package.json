{
  "name": "gutcheck",
  "version": "0.6.0",
  "description": "Diff-scoped mutation probe for AI-written tests: guts each changed function and reruns only its own tests, reporting proven, hollow, one-sided, unverifiable, or no binding test — each with a replayable receipt.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mutation-testing",
    "test-quality",
    "hollow-tests",
    "ai-generated-code",
    "pseudo-tested",
    "testing",
    "claude-code"
  ],
  "files": [
    "checker",
    "mutation",
    "configure",
    "hooks/session-start",
    "integrations",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beepometer/gutcheck.git"
  },
  "homepage": "https://github.com/beepometer/gutcheck",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "gutcheck": "mutation/gutcheck.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node checker/cli.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "gutcheck": "node mutation/gutcheck.mjs",
    "probe": "node mutation/probe.mjs"
  },
  "devDependencies": {
    "ava": "^6.4.1",
    "jest": "^29.7.0",
    "mocha": "^10.8.2",
    "vitest": "^3.2.6"
  }
}
